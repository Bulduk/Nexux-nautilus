FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# ── deps ──────────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/replit-auth-web/package.json  ./lib/replit-auth-web/
COPY lib/api-zod/package.json          ./lib/api-zod/
COPY artifacts/dataclaw/package.json   ./artifacts/dataclaw/
RUN pnpm install --frozen-lockfile

# ── build ─────────────────────────────────────────────────────────────────
FROM base AS builder
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/                   ./lib/
COPY artifacts/dataclaw/    ./artifacts/dataclaw/
COPY --from=deps /app/node_modules ./node_modules
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/dataclaw run build

# ── runtime (static files served by nginx) ────────────────────────────────
FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/dataclaw/dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
